# Image for evaluating the pydegas artifact (library, tests, case studies).
# Multi-architecture: builds natively on linux/amd64 and linux/arm64
# (the locked CPU-only PyTorch wheels exist for both).
FROM python:3.12.16-slim-bookworm@sha256:e697c81897302a4c4333bade000d98038fbb21eb064f8ee1fd42d02ebcd9d337

COPY --from=astral/uv:0.11.33@sha256:77280f2f771df71f90786c314fe1bbc1e023feac652969bbf139c280babf2eb7 /uv /uvx /bin/

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH=/opt/venv/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    MPLBACKEND=Agg

WORKDIR /artifact

# pydegas with the exact dependency versions of uv.lock (incl. pytest), plus
# matplotlib, which the reference implementation imports.
COPY libs/pydegas libs/pydegas
WORKDIR /artifact/libs/pydegas
RUN uv sync --frozen \
 && uv pip install --python /opt/venv/bin/python matplotlib==3.11.2
WORKDIR /artifact

COPY reference reference
COPY examples examples
COPY scripts scripts
COPY LICENSE README.md ./

CMD ["bash"]
